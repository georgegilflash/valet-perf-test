# ==============================================================================
# FlashParking Valet SOAP Performance Testing Configuration
# ==============================================================================

# Protocol to test: SOAP (or REST / BOTH)
TEST_TYPE=SOAP

# Target Base URL
BASE_URL=https://intserver.qa1.flashparking.dev

# ------------------------------------------------------------------------------
# SOAP Settings (valet.asmx - NewMessages4)
# ------------------------------------------------------------------------------
SOAP_ENDPOINT=/device/valet.asmx
SOAP_ACTION=http://kleverlogic.com/webservices/NewMessages4
SOAP_VERSION=1.1

# Valet NewMessages4 Payload Parameters
LOGIN_TOKEN=219952af-36e3-4a9c-a0ba-31eee485b8e7
COMPRESSED=true
POLL_SECONDS=60

# ------------------------------------------------------------------------------
# Timeouts & SLA Thresholds
# Since seconds=60 means the server holds the socket for ~60s:
# - Timeout must be > 60s (e.g. 90s)
# - p95 threshold is set to 65000ms (65s)
# ------------------------------------------------------------------------------
REQUEST_TIMEOUT=90s
THRESHOLD_P95=65000
THRESHOLD_P99=70000
THRESHOLD_ERROR_RATE=0.01
THINK_TIME_SEC=1.0

# ------------------------------------------------------------------------------
# 5-Stage Ramp-Up Profile (Max 3 Concurrent Users)
# ------------------------------------------------------------------------------
# Stage 1: Warm-up with 1 user
STAGE_1_TARGET=1
STAGE_1_DURATION=1m

# Stage 2: Ramp-up to 2 users
STAGE_2_TARGET=2
STAGE_2_DURATION=2m

# Stage 3: Reach peak of 3 users
STAGE_3_TARGET=3
STAGE_3_DURATION=2m

# Stage 4: Maintain steady state with 3 users
STAGE_4_TARGET=3
STAGE_4_DURATION=3m

# Stage 5: Ramp-down to 0 users
STAGE_5_TARGET=0
STAGE_5_DURATION=1m

# ------------------------------------------------------------------------------
# Optional Authentication (if applicable)
# ------------------------------------------------------------------------------
API_TOKEN=
TOKEN_TYPE=Bearer
API_KEY=
API_USERNAME=
API_PASSWORD=

# ==============================================================================
# Device Services Suite (Kiosk, PMS, Sign)
# ==============================================================================
# Endpoint toggles (set to true/false to select which calls to test)
ENABLE_KIOSK_PING=true
ENABLE_KIOSK_GET_SERVER_NAME=false
ENABLE_PMS_NEW_MESSAGES=false
ENABLE_SIGN_NEW_MESSAGES=false
ENABLE_PAYMENTS_NEW_MESSAGES=false

# IDs and GUIDs used by the Device endpoints
KIOSK_ID=00000000-0000-0000-0000-000000000000
COMPANY_LOCATION_ID=00000000-0000-0000-0000-000000000000
COMPANY_LOCATION_MONITOR_ID=00000000-0000-0000-0000-000000000000

# GetKnownDrivers Random Ranges (user-defined range for FromDate and Count)
KNOWN_DRIVERS_FROM_MIN=2026-01-01T00:00:00
KNOWN_DRIVERS_FROM_MAX=2026-08-27T00:00:00
KNOWN_DRIVERS_START=0
KNOWN_DRIVERS_COUNT_MIN=1
KNOWN_DRIVERS_COUNT_MAX=50

# GetKnownDriverChanges Random Ranges (user-defined range for Date and Total)
KNOWN_DRIVER_CHANGES_DATE_MIN=2026-01-01
KNOWN_DRIVER_CHANGES_DATE_MAX=2026-10-16
KNOWN_DRIVER_CHANGES_TOTAL_MIN=1
KNOWN_DRIVER_CHANGES_TOTAL_MAX=50
KNOWN_DRIVER_CHANGES_BURNT=2
