{
  "name": "api-k6-performance-test",
  "version": "1.0.0",
  "type": "module",
  "description": "5-stage ramp-up performance testing suite using Grafana k6",
  "scripts": {
    "tokens": "node ./scripts/generate-tokens.js",
    "locations": "node ./scripts/generate-location-ids.js",
    "kiosks": "node ./scripts/generate-kiosk-ids.js",
    "tokens:ps": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-tokens.ps1",
    "kiosks:ps": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-kiosk-ids.ps1",
    "test": "node ./scripts/run-k6.js main.js",
    "test:debug": "node ./scripts/run-k6.js main.js -e DEBUG_RESPONSE=true",
    "test:soap": "k6 run -e TEST_TYPE=SOAP main.js",
    "test:kiosk": "node ./scripts/run-k6.js main-kiosk.js",
    "test:known-drivers": "node ./scripts/run-k6.js main-known-drivers.js",
    "test:known-drivers:debug": "node ./scripts/run-k6.js main-known-drivers.js -e DEBUG_RESPONSE=true",
    "test:known-drivers:single": "node ./scripts/test-known-drivers.js",
    "test:known-driver-changes": "node ./scripts/run-k6.js main-known-driver-changes.js",
    "test:known-driver-changes:debug": "node ./scripts/run-k6.js main-known-driver-changes.js -e DEBUG_RESPONSE=true",
    "test:known-driver-changes:single": "node ./scripts/test-known-driver-changes.js",
    "test:valet": "node ./scripts/run-k6.js main-valet.js",
    "test:pms": "node ./scripts/run-k6.js main-pms.js",
    "test:sign": "node ./scripts/run-k6.js main-sign.js",
    "test:payments": "node ./scripts/run-k6.js main-payments.js",
    "test:polling": "node ./scripts/run-k6.js main-polling.js",
    "test:device": "node ./scripts/run-k6.js main-device.js",
    "test:device:debug": "node ./scripts/run-k6.js main-device.js -e DEBUG_RESPONSE=true",
    "test:device:quick": "node ./scripts/run-k6.js main-device.js -e STAGE_1_DURATION=5s -e STAGE_1_TARGET=1 -e STAGE_2_DURATION=5s -e STAGE_2_TARGET=2 -e STAGE_3_DURATION=5s -e STAGE_3_TARGET=2 -e STAGE_4_DURATION=5s -e STAGE_4_TARGET=2 -e STAGE_5_DURATION=5s -e STAGE_5_TARGET=0",
    "test:bash": "bash ./scripts/run.sh",
    "test:direct": "k6 run main.js",
    "test:quick": "k6 run -e STAGE_1_DURATION=10s -e STAGE_1_TARGET=5 -e STAGE_2_DURATION=10s -e STAGE_2_TARGET=10 -e STAGE_3_DURATION=10s -e STAGE_3_TARGET=15 -e STAGE_4_DURATION=10s -e STAGE_4_TARGET=15 -e STAGE_5_DURATION=10s -e STAGE_5_TARGET=0 main.js"
  },
  "keywords": [
    "k6",
    "performance-testing",
    "load-testing",
    "api-testing",
    "stress-testing"
  ],
  "author": "",
  "license": "ISC"
}
