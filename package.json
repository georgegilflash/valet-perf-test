{
  "name": "api-k6-performance-test",
  "version": "1.0.0",
  "type": "module",
  "description": "5-stage ramp-up performance testing suite using Grafana k6",
  "scripts": {
    "tokens": "node ./scripts/generate-tokens.js",
    "locations": "node ./scripts/generate-location-ids.js",
    "tokens:ps": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-tokens.ps1",
    "test": "powershell -ExecutionPolicy Bypass -File ./scripts/run.ps1",
    "test:debug": "powershell -ExecutionPolicy Bypass -File ./scripts/run.ps1 -AdditionalArgs \"-e DEBUG_RESPONSE=true\"",
    "test:soap": "powershell -ExecutionPolicy Bypass -Command \"k6 run -e TEST_TYPE=SOAP main.js\"",
    "test:kiosk": "powershell -ExecutionPolicy Bypass -File ./scripts/run-kiosk.ps1",
    "test:known-drivers": "powershell -ExecutionPolicy Bypass -File ./scripts/run-known-drivers.ps1",
    "test:known-drivers:debug": "powershell -ExecutionPolicy Bypass -File ./scripts/run-known-drivers.ps1 -AdditionalArgs \"-e DEBUG_RESPONSE=true\"",
    "test:known-drivers:single": "powershell -ExecutionPolicy Bypass -File ./scripts/test-known-drivers.ps1",
    "test:known-driver-changes": "powershell -ExecutionPolicy Bypass -File ./scripts/run-known-driver-changes.ps1",
    "test:known-driver-changes:debug": "powershell -ExecutionPolicy Bypass -File ./scripts/run-known-driver-changes.ps1 -AdditionalArgs \"-e DEBUG_RESPONSE=true\"",
    "test:known-driver-changes:single": "powershell -ExecutionPolicy Bypass -File ./scripts/test-known-driver-changes.ps1",
    "test:valet": "powershell -ExecutionPolicy Bypass -File ./scripts/run-valet.ps1",
    "test:pms": "powershell -ExecutionPolicy Bypass -File ./scripts/run-pms.ps1",
    "test:sign": "powershell -ExecutionPolicy Bypass -File ./scripts/run-sign.ps1",
    "test:payments": "powershell -ExecutionPolicy Bypass -File ./scripts/run-payments.ps1",
    "test:polling": "powershell -ExecutionPolicy Bypass -File ./scripts/run-polling.ps1",
    "test:device": "powershell -ExecutionPolicy Bypass -File ./scripts/run-device.ps1",
    "test:device:debug": "powershell -ExecutionPolicy Bypass -File ./scripts/run-device.ps1 -AdditionalArgs \"-e DEBUG_RESPONSE=true\"",
    "test:device:quick": "powershell -ExecutionPolicy Bypass -File ./scripts/run-device.ps1 -AdditionalArgs \"-e STAGE_1_DURATION=5s -e STAGE_1_TARGET=1 -e STAGE_2_DURATION=5s -e STAGE_2_TARGET=2 -e STAGE_3_DURATION=5s -e STAGE_3_TARGET=2 -e STAGE_4_DURATION=5s -e STAGE_4_TARGET=2 -e STAGE_5_DURATION=5s -e STAGE_5_TARGET=0\"",
    "test:bash": "bash ./scripts/run.sh",
    "test:direct": "k6 run main.js",
    "test:quick": "k6 run -e STAGE_1_DURATION=10s -e STAGE_1_TARGET=5 -e STAGE_2_DURATION=10s -e STAGE_2_TARGET=10 -e STAGE_3_DURATION=10s -e STAGE_3_TARGET=15 -e STAGE_4_DURATION=10s -e STAGE_4_TARGET=15 -e STAGE_5_DURATION=10s -e STAGE_5_TARGET=0 main.js"
  },
  "keywords": [
    "k6",
    "performance-testing",
    "load-testing",
    "api-testing",
    "stress-testing"
  ],
  "author": "",
  "license": "ISC"
}
